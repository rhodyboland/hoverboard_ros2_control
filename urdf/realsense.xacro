<?xml version="1.0"?>
<robot name="hoverboard_robot" xmlns:xacro="http://ros.org/wiki/xacro">

    <!--
        Front-mounted Intel RealSense D455. The realsense2_camera defaults
        publish the optical/depth frames under camera_link.
    -->
    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.42 0 0.1" rpy="0 0 0"/>
    </joint>

    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.025 0.095 0.025"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <contact_coefficients mu="100.0" kp="0.0" kd="0.0" />
            <geometry>
                <box size="0.025 0.095 0.025"/>
            </geometry>
        </collision>
    </link>

</robot>
