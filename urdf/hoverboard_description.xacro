<?xml version="1.0"?>
<robot name="hoverboard_robot" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:include filename="materials.xacro" />
    <xacro:include filename="macros.xacro" />
    <xacro:include filename="wheels.xacro" />
    <xacro:include filename="ros2_control.xacro" />
    <xacro:include filename="lidar.xacro" />
    <xacro:include filename="gps.xacro" />
    <xacro:include filename="imu.xacro" />

    <xacro:property name="plate_length" value="0.5" />
    <xacro:property name="plate_width" value="0.25" />
    <xacro:property name="plate_height" value="0.2" />

    <xacro:property name="chassis_weight" value="10.0" />

    <xacro:property name="driving_wheel_diameter" value="0.2" />
    <xacro:property name="driving_wheel_thickness" value="0.075" />
    <xacro:property name="driving_wheel_weight" value="2.2" />

    <xacro:property name="caster_wheel_diameter" value="0.09" />
    <xacro:property name="caster_wheel_weight" value="0.1" />

    <link name="base_link">
    </link>

    <link name="plate">
        <visual>
            <origin xyz="${plate_length/2} 0 ${plate_height/2}"/>
            <geometry>
                <box size="${plate_length} ${plate_width} ${plate_height}"/>
            </geometry>
            <material name="blueclear"/>
        </visual>
        <collision>
            <origin xyz="${plate_length/2} 0 ${plate_height/2}"/>
            <geometry>
                <box size="${plate_length} ${plate_width} ${plate_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertia mass="${chassis_weight}" x="${plate_length}" y="${plate_width}" z="${plate_height}">
            <origin xyz="${plate_length/2} 0 ${plate_height/2}" rpy="0.0 0.0 0.0"/>
        </xacro:box_inertia>
    </link>

    <joint name="base_link_plate_joint" type="fixed">
        <origin xyz="-0.095 0 0"/>
        <parent link="base_link" />
        <child link="plate" />
    </joint>

    <link name="base_footprint">
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <origin xyz="0 0 0"/>
        <parent link="base_footprint" />
        <child link="base_link" />
    </joint>


    <xacro:driving_wheel suffix="left" reflect="1"/>
    <xacro:driving_wheel suffix="right" reflect="-1"/>

    <xacro:caster_wheel suffix="back" reflect="1" />

    <xacro:hoverboard_ros2_control name="Hoverboard" />

</robot>
