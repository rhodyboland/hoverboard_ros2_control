<?xml version="1.0"?>
<robot name="hoverboard_robot" xmlns:xacro="http://ros.org/wiki/xacro">

    <!--
        /dev/boxbot/gps_rover antenna. This is the position source used by
        navsat_transform. It sits 5 cm behind the diff-drive axle center.
    -->
    <joint name="gps_joint" type="fixed">
        <parent link="base_link"/>
        <child link="gps"/>
        <origin xyz="-0.05 0 0.225" rpy="0 0 0"/>
    </joint>

    <link name="gps">

        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.05"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <contact_coefficients mu="100.0" kp="0.0" kd="0.0" />
            <geometry>
                <cylinder radius="0.02" length="0.05"/>
            </geometry>
        </collision>
    </link>

    <!--
        /dev/boxbot/gps_moving_base antenna. This receiver is only used to form
        the moving-baseline heading; it is 40 cm in front of the rover antenna.
    -->
    <joint name="gps_moving_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="gps_moving_base"/>
        <origin xyz="0.35 0 0.225" rpy="0 0 0"/>
    </joint>

    <link name="gps_moving_base">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.05"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <contact_coefficients mu="100.0" kp="0.0" kd="0.0" />
            <geometry>
                <cylinder radius="0.02" length="0.05"/>
            </geometry>
        </collision>
    </link>

</robot>
